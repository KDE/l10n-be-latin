#: audiopreview.cpp:51
#, kde-format
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Hety hukavy fajł zachoŭvajecca\n"
"nie na hetym kamputary.\n"
"Klikni ŭ hety nadpis, kab uziać jaho.\n"

