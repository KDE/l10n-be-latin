#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "Nie ŭdałosia padśviatlić punkt menu „%1”."

#: kde-menu.cpp:106
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""
"Pryłada dla pošuku ŭ menu KDE.\n"
"Hetaja prahrama dazvalaje znajści, u jakim menu mieścicca peŭnaja "
"aplikacyja.\n"
"Opcyja „--highlight” vidočna pakazvaje karystańniku, u jakim menu\n"
"mieścicca peŭnaja aplikacyja."

#: kde-menu.cpp:111
msgid "kde-menu"
msgstr "kde-menu"

#: kde-menu.cpp:113
