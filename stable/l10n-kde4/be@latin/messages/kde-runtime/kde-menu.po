msgstr "© 2003 Waldo Bastian"

#: kde-menu.cpp:114
msgid "Waldo Bastian"
msgstr "Waldo Bastian"

#: kde-menu.cpp:114
msgid "Author"
msgstr "Aŭtar"

#: kde-menu.cpp:119
msgid "Output data in UTF-8 instead of local encoding"
msgstr "Vypisvaj vychodnyja źviestki ŭ „UTF-8”, a nie ŭ lakalnym kadavańni."

#: kde-menu.cpp:120
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"Vypišy identyfikatar menu, u jakim źmieščanaja\n"
"patrebnaja aplikacyja."

#: kde-menu.cpp:121
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"Vypišy nazvu menu, u jakim źmieščanaja\n"
"patrebnaja aplikacyja."

#: kde-menu.cpp:122
msgid "Highlight the entry in the menu"
msgstr "Padśviatli punkt menu."

#: kde-menu.cpp:123
msgid "Do not check if sycoca database is up to date"
msgstr "Nia spraŭdžvaj aktualnaści bazy źviestak „sycoca”."

#: kde-menu.cpp:124
msgid "The id of the menu entry to locate"
msgstr "Identyfikatar šukanaha punkta menu"

#: kde-menu.cpp:133
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr ""
"Treba padać identyfikatar aplikacyi, naprykład, „kde4-konsole.desktop”."

#: kde-menu.cpp:142
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr ""
"Treba padać prynamsi adnu z opcyjaŭ: „--print-menu-id”, „--print-menu-name” "
"ci „--highlight”"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "Niama punkta menu „%1”."

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "U menu niama punkta „%1”."
