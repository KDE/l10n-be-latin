#: kio_floppy.cpp:198
#, kde-format
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"Nie ŭdałosia dastupicca da pryłady „%1”.\n"
"Pryłada dasiul zaniataja.\n"
"Pačakaj, pakul jaje vyzvalać, i tady pasprabuj znoŭ."

#: kio_floppy.cpp:202 kio_floppy.cpp:1116
#, kde-format
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"Nie ŭdałosia zapisać u fajł „%1”.\n"
"Dysk u pryładzie „%2”, mabyć, zapoŭnieny."

#: kio_floppy.cpp:212
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"Nie ŭdałosia dastupicca da „%1”.\n"
"Mabyć, u pryładzie „%2” niama dysku."

#: kio_floppy.cpp:216
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"Nie ŭdałosia dastupicca da „%1”.\n"
"Mabyć, u pryładzie „%2” niama dysku albo tabie nie staje dazvołu na dostup "
"da hetaj pryłady."

#: kio_floppy.cpp:220
#, kde-format
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"Nie ŭdałosia dastupicca da „%1”.\n"
"Pryłada „%2” nie absłuhoŭvajecca."

#: kio_floppy.cpp:225
#, kde-format
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"Nie ŭdałosia dastupicca da „%1”.\n"
"Spraŭdź, što ŭ pryładu „%2” usunuty dysk u farmacie „DOS”, a dazvoły na fajł "
"pryłady (naprykład, „/dev/fd0”) vyznačanyja pravilna (naprykład, "
"„rwxrwxrwx”)."

#: kio_floppy.cpp:229
#, kde-format
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"Nie ŭdałosia dastupicca da „%1”.\n"
"Mabyć, u pryładu „%2” usunuty dysk nie ŭ farmacie „DOS”."

#: kio_floppy.cpp:233
#, kde-format
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"Dostup zabaronieny.\n"
"Nie ŭdałosia zapisać u „%1”.\n"
"Mabyć, dysk, jaki ŭsunuty ŭ pryładu „%2”, abaronieny ad zapisu."

#: kio_floppy.cpp:242
#, kde-format
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"Nie ŭdałosia pračytać pačatny sektar z „%1”.\n"
"Mabyć, u pryładu „%2” nia ŭsunuty dysk."

#: kio_floppy.cpp:365
#, kde-format
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"Nie ŭdałosia ŭklučyć prahramu „%1”.\n"
"Spraŭdź, kab u systemie byŭ pravilna zainstalavany pakunak „mtools”."
