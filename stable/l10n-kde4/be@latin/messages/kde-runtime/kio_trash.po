#: kcmtrash.cpp:158 kcmtrash.cpp:266
#, kde-format
msgid " day"
msgid_plural " days"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: kcmtrash.cpp:220
#, kde-format
msgid ""
"<para>KDE's wastebin is configured to use the <b>Finder</b>'s Trash.<br></"
"para>"
msgstr ""

#: kcmtrash.cpp:222
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Emptying KDE's wastebin will remove only KDE's trash items, "
"while<br>emptying the Trash through the Finder will delete everything.</"
"para><para>KDE's trash items will show up in a folder called KDE.trash, in "
"the Trash can.</para>"
msgstr ""

#: kcmtrash.cpp:257
#, kde-format
msgid "Delete files older than:"
msgstr "Vydali fajły, starejšyja za:"

#: kcmtrash.cpp:259
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to allow <b>automatic deletion</b> of files that are "
"older than the value specified. Leave this disabled to <b>not</b> "
"automatically delete any items after a certain timespan</para>"
msgstr ""

#: kcmtrash.cpp:268
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Set the number of days that files can remain in the trash. Any files "
"older than this will be automatically deleted.</para>"
msgstr ""

#: kcmtrash.cpp:276
#, kde-format
msgid "Limit to maximum size"
msgstr "Abmiažuj u pamiery"

#: kcmtrash.cpp:278
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to limit the trash to the maximum amount of disk space "
"that you specify below. Otherwise, it will be unlimited.</para>"
msgstr ""

#: kcmtrash.cpp:296
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the maximum percent of disk space that will be used for the "
"trash.</para>"
msgstr ""

#: kcmtrash.cpp:301
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the calculated amount of disk space that will be allowed for "
"the trash, the maximum.</para>"
msgstr ""

#: kcmtrash.cpp:304
#, kde-format
msgid "Maximum size:"
msgstr "Najbolšy pamier:"

#: kcmtrash.cpp:306
#, kde-format
msgid "When limit reached:"
msgstr "Kali dasiahnutaja miaža:"

#: kcmtrash.cpp:310
#, kde-format
msgid "Warn Me"
msgstr "Papiaredžvaj"

#: kcmtrash.cpp:311
#, kde-format
msgid "Delete Oldest Files From Trash"
msgstr "Vydali starejšyja fajły ź śmietnicy"

#: kcmtrash.cpp:312
#, kde-format
msgid "Delete Biggest Files From Trash"
msgstr "Vydali bolšyja fajły ź śmietnicy"

#: kcmtrash.cpp:314
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<para>When the size limit is reached, it will prefer to delete the type of "
"files that you specify, first. If this is set to warn you, it will do so "
"instead of automatically deleting files.</para>"
msgstr ""

#: kio_trash.cpp:92 kio_trash.cpp:155 kio_trash.cpp:310 kio_trash.cpp:342
#: kio_trash.cpp:510 kio_trash.cpp:522
#, kde-format
msgid "Malformed URL %1"
msgstr "Kiepski adras „%1”."

#: kio_trash.cpp:111
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Kataloh „%1” užo nie isnuje, tamu niemahčyma ŭznavić hety fajł u byłym "
"miescy. Možna stvaryć hety kataloh i paŭtaryć sprobu ŭznaŭleńnia albo "
"pieraciahnuć patrebny fajł u inšaje miesca."

#: kio_trash.cpp:140 kio_trash_win.cpp:228
#, kde-format
msgid "This file is already in the trash bin."
msgstr "Hety fajł užo lažyć u śmietnicy."

#: kio_trash.cpp:228 kio_trash_win.cpp:252
#, kde-format
msgid "Internal error in copyOrMove, should never happen"
msgstr ""

#: kio_trash_win.cpp:241
#, kde-format
msgid "not supported"
msgstr ""

#: ktrash.cpp:32
#, kde-format
msgid "ktrash"
msgstr "ktrash"

#: ktrash.cpp:34
#, kde-format
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"Dapamožnaja prahrama, jakaja absłuhoŭvaje śmietnicu „KDE”\n"
"Uvaha: nie karystajsia modulem „ktrash” dla vykidańnia fajłaŭ. Lepš "
"pasprabuj zahad: „kioclient move 'adras' trash:/”"

#: ktrash.cpp:38
#, kde-format
msgid "Empty the contents of the trash"
msgstr "Vyčyści śmietnicu"

#: ktrash.cpp:40
#, kde-format
msgid "Restore a trashed file to its original location"
msgstr "Uznavi vykinuty fajł u byłym miescy"

#: ktrash.cpp:42
#, kde-format
msgid "Ignored"
msgstr "Abminuta"

#: trashimpl.cpp:1255
#, kde-format
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"Śmietnica zapoŭniłasia!\n"
"Vyčyści jaje samastojna."

#: trashimpl.cpp:1266
#, kde-format
msgid "The file is too large to be trashed."
msgstr "Fajł nadta vialiki dla śmietnicy."

