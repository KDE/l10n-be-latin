#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "Syntaksnaja pamyłka: nieviadomy zahad „%1”"

#: solid-hardware.cpp:392
#, kde-format
msgid "Error: %1 does not have the interface StorageAccess."
msgstr "Pamyłka: %1 nia maje interfejsu „StorageAccess”."

#: solid-hardware.cpp:397
#, kde-format
msgid "Error: %1 does not have the interface OpticalDrive."
msgstr "Pamyłka: %1 nia maje interfejsu „OpticalDrive”."

#: solid-hardware.cpp:430
#, kde-format
msgid "Error: %1"
msgstr "Pamyłka: %1"

#: solid-hardware.cpp:465
#, kde-format
msgid "Progress: %1%"
msgstr "Prahres: %1%"

#: solid-hardware.cpp:471
#, kde-format
msgid "Info: %1"
msgstr "Źviestki: %1"
