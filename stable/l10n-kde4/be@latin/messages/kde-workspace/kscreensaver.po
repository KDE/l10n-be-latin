#: random.cpp:48
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"Karystańnie: %1 [-setup] [arhumenty]\n"
"Uklučaje vypadkovaha achoŭnika ekranu.\n"
"Usie arhumenty (akramia „-setup”) pierasyłajucca achoŭniku ekranu."

#: random.cpp:55
#, kde-format
msgid "Start a random KDE screen saver"
msgstr "Uklučy vypadkovaha achoŭnika ekranu KDE"

#: random.cpp:70
#, kde-format
msgid "Random screen saver"
msgstr "Vypadkovy achoŭnik ekranu"

#: random.cpp:76
#, kde-format
msgid "Setup screen saver"
msgstr "Naładź achoŭnika ekranu"

#: random.cpp:78
#, kde-format
msgid "Run in the specified XWindow"
msgstr "Uklučy ŭ peŭnym aknie „XWindow”"

#: random.cpp:80
#, kde-format
msgid "Run in the root XWindow"
msgstr "Uklučy ŭ hałoŭnym aknie „XWindow”"

#: random.cpp:194
#, kde-format
msgid "Setup Random Screen Saver"
msgstr "Nałady vypadkovaha achoŭnika ekranu"

#: random.cpp:202
#, kde-format
