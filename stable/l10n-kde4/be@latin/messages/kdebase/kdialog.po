#: kdialog.cpp:738
msgid "Question message box with yes/no buttons"
msgstr "Akno-pytańnie z knopkami „Tak” i „Nie”"

#: kdialog.cpp:739
msgid "Question message box with yes/no/cancel buttons"
msgstr "Akno-pytańnie z knopkami „Tak”, „Nie” i „Anuluj”"

#: kdialog.cpp:740
msgid "Warning message box with yes/no buttons"
msgstr "Akno-papiaredžańnie z knopkami „Tak” i „Nie”"

#: kdialog.cpp:741
msgid "Warning message box with continue/cancel buttons"
msgstr "Akno-papiaredžańnie z knopkami „Praciahvaj” i „Anuluj”"

#: kdialog.cpp:742
msgid "Warning message box with yes/no/cancel buttons"
msgstr "Akno-papiaredžańnie z knopkami „Tak”, „Nie” i „Anuluj”"

#: kdialog.cpp:743
msgid "'Sorry' message box"
msgstr "Akno-vybačeńnie"

#: kdialog.cpp:744
msgid "'Error' message box"
msgstr "Akno-pamyłka"

#: kdialog.cpp:745
msgid "Message Box dialog"
msgstr "Akno-paviedamleńnie"

#: kdialog.cpp:746
msgid "Input Box dialog"
msgstr "Akno dla ŭpisańnia"

#: kdialog.cpp:747
msgid "Password dialog"
msgstr "Akno dla ŭpisańnia parola"

#: kdialog.cpp:748
msgid "Text Box dialog"
msgstr "Akno z tekstam"

#: kdialog.cpp:749
msgid "Text Input Box dialog"
msgstr "Akno dla ŭpisańnia tekstu"

#: kdialog.cpp:750
msgid "ComboBox dialog"
msgstr "Akno z vypłyŭnym śpisam"

#: kdialog.cpp:751
msgid "Menu dialog"
msgstr "Akno z menu"

#: kdialog.cpp:752
msgid "Check List dialog"
msgstr "Akno ź śpisam opcyjaŭ"

#: kdialog.cpp:753
msgid "Radio List dialog"
msgstr "Akno ź pieraklučnikami"

#: kdialog.cpp:754
msgid "Passive Popup"
msgstr "Pasiŭnaje vypłyŭnoje akno"

#: kdialog.cpp:755
msgid "File dialog to open an existing file"
msgstr "Akno adčynieńnia fajła"

#: kdialog.cpp:756
msgid "File dialog to save a file"
msgstr "Akno zapisu fajła"

#: kdialog.cpp:757
msgid "File dialog to select an existing directory"
msgstr "Akno vybaru kataloha"

#: kdialog.cpp:758
msgid "File dialog to open an existing URL"
msgstr "Akno naviedvańnia peŭnaha adrasu"

#: kdialog.cpp:759
msgid "File dialog to save a URL"
msgstr "Akno zapisu źmieściva z peŭnaha adrasu"

#: kdialog.cpp:760
msgid "Icon chooser dialog"
msgstr "Akno vybaru ikony"

#: kdialog.cpp:761
msgid "Progress bar dialog, returns a D-Bus reference for communication"
msgstr ""
"Akno vyjaŭleńnia čynnaści aperacyi. Viartaje spasyłku systemy „D-Bus”, praź "
"jakuju možna brać źviestki."

#: kdialog.cpp:762
msgid "Color dialog to select a color"
msgstr "Akno vybaru kolera"

#: kdialog.cpp:764
msgid "Dialog title"
msgstr "Zahałovak akna"

#: kdialog.cpp:765
msgid "Default entry to use for combobox, menu and color"
msgstr "Zmoŭčany punkt dla vypłyŭnoha śpisu, menu ci kolera"

#: kdialog.cpp:766
msgid ""
"Allows the --getopenurl and --getopenfilename options to return multiple "
"files"
msgstr ""
"Dazvalaje opcyjam „--getopenurl” i „--getopenfilename” viartać niekalki "
"fajłaŭ."

#: kdialog.cpp:767
msgid ""
"Return list items on separate lines (for checklist option and file open with "
"--multiple)"
msgstr ""
"Viartaje śpis, vyviedzieny ŭ niekalki radkoŭ (dla akna opcyjaŭ ci vybaru "
"fajłaŭ, kali ŭklučanaja opcyja „--multiple”)."

#: kdialog.cpp:768
msgid "Outputs the winId of each dialog"
msgstr "Vyvodzić identyfikatar usich akon."

#: kdialog.cpp:769
msgid ""
"Config file and option name for saving the \"do-not-show/ask-again\" state"
msgstr ""
"Fajł naładaŭ ci nazva opcyi dla pierachoŭvańnia źviestak pra zrobleny vybar "
"„Bolš nie pakazvaj” ci „Bolš nie pytaj”."

#: kdialog.cpp:773
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "Prystasoŭvaje akno da aplikacyi z aznačanym identyfikataram akna."

#: kdialog.cpp:776
msgid "Arguments - depending on main option"
msgstr "Arhumenty, zaležnyja ad hałoŭnaha vybaru"

