#~ msgid "Use current desktop theme color"
#~ msgstr "Karystajsia kolerami dziejnaha matyvu rabočaha stała"

#~ msgid ""
#~ "This is default. The clock will get its font color from the current "
#~ "desktop theme."
#~ msgstr ""
#~ "Heta zmoŭčanaja vartaść nałady. Šryft hadzińnika budzie adpaviadać "
#~ "koleru, aznačanamu dla dziejnaha matyvu rabočaha stała."

#~ msgid "Use theme color"
