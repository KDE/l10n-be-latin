msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # methods supported by the system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policies\n"
msgstr ""
"             # Pakažy peŭnyja źviestki pra systemu aščadžeńnia enerhii.\n"
"             # - Kali padadzienaja opcyja „suspend”, pakazvaje śpis "
"sposabaŭ\n"
"             # snu, jakija absłuhoŭvaje hetaja systema\n"
"             # - Kali padadzienaja opcyja „scheme”, pakazvaje śpis schiemaŭ\n"
"             # aščadžeńnia enerhii, jakija absłuhoŭvaje hetaja systema\n"
"             # - Kali padadzienaja opcyja „cpufreq”, pakazvaje śpis "
"praviłaŭ\n"
"             # źmianieńnia čaścini pracesara, jakija absłuhoŭvaje hetaja "
"systema\n"

#: solid-powermanagement.cpp:206
#, fuzzy
#| msgid ""
#| "             # Set power management options of the system.\n"
#| "             # - If the 'scheme' option is specified, the power "
#| "management\n"
#| "             # scheme set corresponds to 'value'\n"
#| "             # - If the 'cpufreq' option is specified, the CPU frequency "
#| "policy\n"
#| "             # set corresponds to 'value'\n"
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # Nastaŭ nałady aščadžeńnia enerhii ŭ systemie.\n"
"             # - Kali padadzienaja opcyja „scheme”, tady schiema aščadžeńnia "
"enerhii\n"
"             # budzie vystaŭlenaja adpaviedna padadzienaj vartaści\n"
"             # - Kali padadzienaja opcyja „cpufreq”, tady praviły "
"źmianieńnia\n"
"             # čaścini pracesara buduć vystaŭlenyja adpaviedna padadzienaj "
"vartaści\n"

#: solid-powermanagement.cpp:211
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # Usypi kamputar u aznačany sposab.\n"

#: solid-powermanagement.cpp:214
msgid ""
"             # Set and get brightness options of the system.\n"
"             # - If the 'set' option is specified, the brightness is\n"
"             # set to 'value' (as a percentage)\n"
"             # - If the 'get' option is specified, the current brightness\n"
"             # is returned (as a percentage)'\n"
msgstr ""
"             # Aznač ci zapytaj pra nałady jarkaści systemy.\n"
"             # - Kali padadzienaja opcyja „set”, tady jarkaść aznačajecca "
"adpaviedna\n"
"             # padadzienaj vartaści (u adsotkach)\n"
"             # - Kali padadzienaja opcyja „get”, tady viartajecca dziejnaja "
"nałada jarkaści\n"
"             # (u adsotkach)\n"

