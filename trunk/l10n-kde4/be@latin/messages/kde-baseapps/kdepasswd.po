#: kdepasswd.cpp:42
msgid "Changes a UNIX password."
msgstr "Źmianiaje parol systemy „UNIX”."

#: kdepasswd.cpp:43
msgid "Copyright (c) 2000 Geert Jansen"
msgstr "Copyright © 2000 Geert Jansen"

#: kdepasswd.cpp:44
msgid "Geert Jansen"
msgstr "Geert Jansen"

#: kdepasswd.cpp:44
msgid "Maintainer"
msgstr "Dahladnik"

#: kdepasswd.cpp:51
msgid "Change password of this user"
msgstr "Źmiani parol dla hetaha karystańnika"

#: kdepasswd.cpp:74
msgid "You need to be root to change the password of other users."
msgstr ""
"Kab źmianiać paroli dla inšych karystańnikaŭ, treba mieć dazvoły roŭniu "
"„root”."

#: passwddlg.cpp:34 passwddlg.cpp:101
#, fuzzy
#| msgid "Change Password"
msgctxt "@title:window"
msgid "Change Password"
msgstr "Źmiani parol"

#: passwddlg.cpp:35
msgid "Please enter your current password:"
msgstr "Upišy svoj dziejny parol:"

#: passwddlg.cpp:55 passwddlg.cpp:179
msgid "Conversation with 'passwd' failed."
msgstr "Nie ŭdałosia źviazacca z prahramaju „passwd”."

#: passwddlg.cpp:65
msgid "Could not find the program 'passwd'."
msgstr "Nie ŭdałosia znajści prahramu „passwd”."

#: passwddlg.cpp:70
msgid "Incorrect password. Please try again."
msgstr "Parol niapravilny. Kali łaska, paŭtary sprobu."

#: passwddlg.cpp:74
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr ""
"Unutranaja pamyłka: zabaronienaja vartaść, viernutaja z „PasswdProcess::"
"checkCurrent”."

#: passwddlg.cpp:103
msgid "Please enter your new password:"
msgstr "Upišy svoj novy parol:"

#: passwddlg.cpp:105
#, kde-format
msgid "Please enter the new password for user <b>%1</b>:"
msgstr "Upišy novy parol dla karystańnika <b>%1</b>:"

#: passwddlg.cpp:127
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Tvoj parol daŭžejšy za 8 znakaŭ. U niekatorych systemach z hetaha mohuć "
"vynikać peŭnyja prablemy. Možaš skaracić svoj parol da 8 znakaŭ albo pakinuć "
"jaho, jakim jość."

#: passwddlg.cpp:130
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Hety parol daŭžejšy za 8 znakaŭ. U niekatorych systemach z hetaha mohuć "
"vynikać peŭnyja prablemy. Možaš skaracić hety parol da 8 znakaŭ albo pakinuć "
"jaho, jakim jość."

#: passwddlg.cpp:134
msgid "Password Too Long"
msgstr "Zadoŭhi parol"

#: passwddlg.cpp:135
msgid "Truncate"
msgstr "Skaraci"

#: passwddlg.cpp:136
msgid "Use as Is"
msgstr "Jak jość"

#: passwddlg.cpp:158
msgid "Your password has been changed."
msgstr "Tvoj parol źmienieny."

#: passwddlg.cpp:168
msgid "Your password has not been changed."
msgstr "Tvoj parol nia źmienieny."

