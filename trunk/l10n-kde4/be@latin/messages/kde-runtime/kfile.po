#: fileprops.cpp:230
msgid "kfile"
msgstr "kfile"

#: fileprops.cpp:231
msgid "A command-line tool to read and modify metadata of files."
msgstr "Terminalnaja pryłada dla čytańnia j źmianieńnia metaźviestak fajłaŭ."

#: fileprops.cpp:232
msgid "(c) 2002, Carsten Pfeiffer"
msgstr "© 2002 Carsten Pfeiffer"

#: fileprops.cpp:236
msgid "Carsten Pfeiffer"
msgstr "Carsten Pfeiffer"

#: fileprops.cpp:245
msgid "Do not print the mimetype of the given file(s)"
msgstr "Nie vypisvaj typu MIME dla padadzienaha fajła"

#: fileprops.cpp:247
msgid "List all supported metadata keys."
msgstr "Vypišy ŭsie viadomyja klučy metaźviestak."

#: fileprops.cpp:249
msgid "List all metadata keys which have a value in the given file(s)."
msgstr ""
"Vypišy ŭsie klučy metaźviestak, jakija majuć vartaść u padadzienych fajłach."

#: fileprops.cpp:252
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr ""
"Nie vypisvaj papiaredžańnia, kali padadzienyja niekalki fajłaŭ roznych typaŭ "
"MIME."

#: fileprops.cpp:255
msgid "Prints all metadata values, available in the given file(s)."
msgstr "Vypišy ŭsie vartaści metaźviestak, jakija jość u padadzienych fajłach."

#: fileprops.cpp:257
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr ""
"Adčyni akno ŭłaścivaściaŭ systemy KDE dla prahladu j źmieny metaźviestak u "
"padadzienych fajłaŭ."

#: fileprops.cpp:259
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""
"Vypišy vartaść „kluča” dla padadzienych fajłaŭ. „Kluč” taksama moža być "
"śpisam ź niekalkich klučoŭ, padzielenych znakami kosak."

#: fileprops.cpp:261
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr "Vyznačy „vartaść” dla „kluča” metaźviestak padadzienych fajłaŭ."

#: fileprops.cpp:263
msgid "The file (or a number of files) to operate on."
msgstr "Adzin ci niekalki patrebnych fajłaŭ."

#: fileprops.cpp:277
msgid "No files specified"
msgstr "Nie padadziena fajłaŭ."

#: fileprops.cpp:297
msgid "Cannot determine metadata"
msgstr "Nie ŭdałosia vyznačyć metaźviestki."
