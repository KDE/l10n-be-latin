#: localetime.cpp:603
msgid ""
"<p>This option determines which day will be considered as the first one of "
"the week.</p>"
msgstr "<p>Hetaja opcyja aznačaje, jaki dzień jość pačatkam tydnia.</p>"

#: localetime.cpp:608
msgid ""
"<p>This option determines which day will be considered as the first working "
"day of the week.</p>"
msgstr ""
"<p>Hetaja opcyja aznačaje, jaki dzień jość pačatkam pracoŭnaha tydnia.</p>"

#: localetime.cpp:613
msgid ""
"<p>This option determines which day will be considered as the last working "
"day of the week.</p>"
msgstr ""
"<p>Hetaja opcyja aznačaje, jaki dzień jość kancom pracoŭnaha tydnia.</p>"

#: localetime.cpp:618
msgid ""
"<p>This option determines which day will be considered as the day of the "
"week for religious observance.</p>"
msgstr "<p>Hetaja opcyja aznačaje, jaki dzień jość śviatym dniom.</p>"

#: localetime.cpp:625
msgid ""
"<p>This option determines whether possessive form of month names should be "
"used in dates.</p>"
msgstr ""
"<p>Hetaja opcyja aznačaje, ci treba ŭžyvać u datach nazvy miesiaca ŭ rodnym "
"skłonie.</p>"

#: localetime.cpp:635
msgctxt "Day name list, option for no day of religious observance"
