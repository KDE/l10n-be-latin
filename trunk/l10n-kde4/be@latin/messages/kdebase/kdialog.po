#: kdialog.cpp:696
msgid ""
"Allows the --getopenurl and --getopenfilename options to return multiple "
"files"
msgstr "Dazvalaje opcyjam „--getopenurl” i „--getopenfilename” viartać niekalki fajłaŭ."

#: kdialog.cpp:697
msgid ""
"Return list items on separate lines (for checklist option and file open with "
"--multiple)"
msgstr "Viartaje śpis, vyviedzieny ŭ niekalki radkoŭ (dla akna opcyjaŭ ci vybaru fajłaŭ, kali ŭklučanaja opcyja „--multiple”)."

#: kdialog.cpp:698
msgid "Outputs the winId of each dialog"
msgstr "Vyvodzić identyfikatar usich akon."

#: kdialog.cpp:699
msgid "Config file and option name for saving the \"do-not-show/ask-again\" state"
msgstr "Fajł naładaŭ ci nazva opcyi dla pierachoŭvańnia źviestak pra zrobleny vybar „Bolš nie pakazvaj” ci „Bolš nie pytaj”."

#: kdialog.cpp:703
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "Prystasoŭvaje akno da aplikacyi z aznačanym identyfikataram akna."

#: kdialog.cpp:706
msgid "Arguments - depending on main option"
msgstr "Arhumenty, zaležnyja ad hałoŭnaha vybaru"

