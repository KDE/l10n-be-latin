msgid "Progress bar dialog, returns a D-Bus reference for communication"
msgstr "Akno vyjaŭleńnia čynnaści aperacyi. Viartaje spasyłku systemy „D-Bus”, praź jakuju možna brać źviestki."

#: kdialog.cpp:692
