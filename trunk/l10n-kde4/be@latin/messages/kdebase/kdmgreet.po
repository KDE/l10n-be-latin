msgid "Root logins are not allowed."
msgstr "Nielha ŭvachodzić karystańniku „root”."

#: kgverify.cpp:473
msgid "Your account has expired; please contact your system administrator."
msgstr ""
"Tvoj kont praterminavany. Źviarnisia da svajho systemnaha administratara pa "
"dapamohu."

#: kgverify.cpp:483
msgid ""
"A critical error occurred.\n"
"Please look at KDM's logfile(s) for more information\n"
"or contact your system administrator."
msgstr ""
"Uźnikła važnaja pamyłka.\n"
"Bolš źviestak možna znajści ŭ fajłach logaŭ „KDM”.\n"
"Taksama pa dapamohu možaš źviarnucca da svajho systemnaha administratara."

#: kgverify.cpp:508
#, kde-format
