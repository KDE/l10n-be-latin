msgid "You are required to change your password immediately (password aged)."
msgstr "Ty musiš zaraz ža źmianić svoj parol, jaki zastareŭ."

#: kgverify.cpp:467
msgid "You are required to change your password immediately (root enforced)."
msgstr ""
"Ty musiš zaraz ža źmianić svoj parol, bo hetaha vymahaje karystańnik „root”."

#: kgverify.cpp:468
msgid "You are not allowed to login at the moment."
msgstr "Tabie zaraz nielha ŭvachodzić."

#: kgverify.cpp:469
msgid "Home folder not available."
msgstr "Niama chatniaha kataloha."

#: kgverify.cpp:470
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"Zaraz nielha ŭvachodzić.\n"
"Paŭtary sprobu paźniej."

