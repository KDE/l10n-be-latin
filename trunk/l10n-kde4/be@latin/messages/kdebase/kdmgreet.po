"Logging in %1...\n"
"\n"
msgstr ""
"Uvachod u „%1”...\n"
"\n"

#: kgverify.cpp:488
msgid "You are required to change your password immediately (password aged)."
msgstr "Ty musiš zaraz ža źmianić svoj parol, jaki zastareŭ."

#: kgverify.cpp:489
msgid "You are required to change your password immediately (root enforced)."
msgstr ""
"Ty musiš zaraz ža źmianić svoj parol, bo hetaha vymahaje karystańnik „root”."

#: kgverify.cpp:490
msgid "You are not allowed to login at the moment."
msgstr "Tabie zaraz nielha ŭvachodzić."

#: kgverify.cpp:491
msgid "Home folder not available."
msgstr "Niama chatniaha kataloha."

#: kgverify.cpp:492
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"Zaraz nielha ŭvachodzić.\n"
"Paŭtary sprobu paźniej."

#: kgverify.cpp:493
msgid "Your login shell is not listed in /etc/shells."
msgstr "Tvajoj uvachodnaj abałonki niama ŭ śpisie z fajła „/etc/shells”."

#: kgverify.cpp:494
msgid "Root logins are not allowed."
msgstr "Nielha ŭvachodzić karystańniku „root”."

#: kgverify.cpp:495
msgid "Your account has expired; please contact your system administrator."
msgstr ""
"Tvoj kont praterminavany. Źviarnisia da svajho systemnaha administratara pa "
"dapamohu."

#: kgverify.cpp:505
msgid ""
"A critical error occurred.\n"
"Please look at KDM's logfile(s) for more information\n"
"or contact your system administrator."
msgstr ""
"Uźnikła važnaja pamyłka.\n"
"Bolš źviestak možna znajści ŭ fajłach logaŭ „KDM”.\n"
"Taksama pa dapamohu možaš źviarnucca da svajho systemnaha administratara."

#: kgverify.cpp:530
#, kde-format
msgid "Your account expires tomorrow."
msgid_plural "Your account expires in %1 days."
msgstr[0] "Tvoj kont praterminujecca praz %1 dzień."
msgstr[1] "Tvoj kont praterminujecca praz %1 dni."
msgstr[2] "Tvoj kont praterminujecca praz %1 dzion."

#: kgverify.cpp:532
msgid "Your account expires today."
msgstr "Tvoj kont praterminujecca siońnia."

#: kgverify.cpp:538
#, kde-format
