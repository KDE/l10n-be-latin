#: src/konqmainwindow.cpp:3794
msgid ""
"<html>Reload the currently displayed document<br /><br />This may, for "
"example, be needed to refresh web pages that have been modified since they "
"were loaded, in order to make the changes visible.</html>"
msgstr ""
"<html>Pieračytaj hety dakument<br /><br />Heta moža spatrebicca, kab "
"aktualizavać źmieściva staronki, kali jano źmianiałasia paśla apošniaha "
"pračytańnia.</html>"

#: src/konqmainwindow.cpp:3797
msgid "Reload the currently displayed document"
msgstr "Pieračytaj hety dakument"

#: src/konqmainwindow.cpp:3799
msgid ""
"<html>Reload all currently displayed documents in tabs<br /><br />This may, "
"for example, be needed to refresh web pages that have been modified since "
"they were loaded, in order to make the changes visible.</html>"
msgstr ""
"<html>Pieračytaj dakumenty z usich kartak<br /><br />Heta moža spatrebicca, "
"kab aktualizavać źmieściva staronak, kali jano źmianiałasia paśla apošniaha "
"pračytańnia.</html>"

#: src/konqmainwindow.cpp:3802
msgid "Reload all currently displayed document in tabs"
msgstr "Pieračytaj dakumenty z usich kartak"

#: src/konqmainwindow.cpp:3804
msgid ""
"<html>Stop loading the document<br /><br />All network transfers will be "
"stopped and Konqueror will display the content that has been received so far."
"</html>"
msgstr ""
"<html>Spyni pračytańnie dakumenta<br /><br />Usio pierasyłańnie źviestak "
"budzie spynienaje, a hartač „Konqueror” pakaža źmieściva, jakoje ŭžo było "
"atrymanaje.</html>"

#: src/konqmainwindow.cpp:3808
msgid ""
"<html>Reload the currently displayed document<br /><br />This may, for "
"example, be needed to refresh web pages that have been modified since they "
"were loaded, in order to make the changes visible.  Any images on the page "
"are downloaded again, even if cached copies exist.</html>"
msgstr ""
"<html>Pieračytaj hety dakument<br /><br />Heta moža spatrebicca, kab "
"aktualizavać źmieściva staronki, kali jano źmianiałasia paśla apošniaha "
"pračytańnia. Usie vyjavy sa staronki buduć uziatyja ź sieciva nanoŭ, navat "
"kali jany ŭžo mieściacca ŭ padručnym schoviščy ŭ hetym kamputary.</html>"

#: src/konqmainwindow.cpp:3812
msgid ""
"Force a reload of the currently displayed document and any contained images"
msgstr "Musova pieračytaj hety dakument z usimi vyjavami"

#: src/konqmainwindow.cpp:3815
msgid "Stop loading the document"
msgstr "Spyni pračytańnie dakumenta"

#: src/konqmainwindow.cpp:3817
msgid ""
"<html>Cut the currently selected text or item(s) and move it to the system "
"clipboard<br /><br />This makes it available to the <b>Paste</b> command in "
"Konqueror and other KDE applications.</html>"
msgstr ""
"<html>Vytni vyłučanaje i źmiaści jaho ŭ systemny abmienny bufer<br /><br /"
">Vytnutaje budzie dastupnaje z „Konqueror” dy inšych prahramaŭ dla KDE praz "
"zahad <b>Uklej</b>.</html>"

#: src/konqmainwindow.cpp:3821
msgid "Move the selected text or item(s) to the clipboard"
msgstr "Pieraniasi vyłučanaje ŭ abmienny bufer"

#: src/konqmainwindow.cpp:3823
msgid ""
"<html>Copy the currently selected text or item(s) to the system "
"clipboard<br /><br />This makes it available to the <b>Paste</b> command in "
"Konqueror and other KDE applications.</html>"
msgstr ""
"<html>Skapijuj vyłučanaje ŭ systemny abmienny bufer<br /><br />Skapijavanaje "
"budzie dastupnaje z „Konqueror” dy inšych prahramaŭ dla KDE praz zahad "
"<b>Uklej</b>.</html>"

#: src/konqmainwindow.cpp:3827
msgid "Copy the selected text or item(s) to the clipboard"
msgstr "Skapijuj vyłučanaje ŭ abmienny bufer"

#: src/konqmainwindow.cpp:3829
msgid ""
"<html>Paste the previously cut or copied clipboard contents<br /><br />This "
"also works for text copied or cut from other KDE applications.</html>"
msgstr ""
"<html>Uklej papiarednie vytnutaje ci skapijavanaje źmieściva abmiennaha "
"bufera<br /><br />Hetaja aperacyja dziejničaje i z tekstam, vytnutym ci "
"skapijavanym ź inšych aplikacyjaŭ dla KDE.</html>"

#: src/konqmainwindow.cpp:3832
msgid "Paste the clipboard contents"
msgstr "Uklej źmieściva abmiennaha bufera"

#: src/konqmainwindow.cpp:3834
msgid ""
"<html>Print the currently displayed document<br /><br />You will be "
"presented with a dialog where you can set various options, such as the "
"number of copies to print and which printer to use.<br /><br />This dialog "
"also provides access to special KDE printing services such as creating a PDF "
"file from the current document.</html>"
msgstr ""
"<html>Vydrukuj hety dakument<br /><br />Hetaja aperacyja adčyniaje "
"dyjalohavaje akno, dzie možna źmianić roznyja nałady, naprykład, kolkaść "
"patrebnych kopijaŭ dakumenta j vybrać drukarku.<br /><br />Praz hetaje akno "
"taksama možna vykarystać specyjalnyja słužby vydruku systemy „KDE”, "
"naprykład, stvaryć fajł „PDF” z dakumenta.</html>"

#: src/konqmainwindow.cpp:3840
msgid "Print the current document"
msgstr "Vydrukuj hety dakument"

#: src/konqmainwindow.cpp:3846
