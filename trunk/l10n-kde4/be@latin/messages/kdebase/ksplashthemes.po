#: installer.cpp:129
msgid "Get New Themes..."
msgstr "Vaźmi novych matyvaŭ..."

#: installer.cpp:130
msgid "Get new themes from the Internet"
msgstr "Vaźmi novych matyvaŭ ź sieciva"

#: installer.cpp:131
msgid ""
"You need to be connected to the Internet to use this action. A dialog will "
"display a list of themes from the http://www.kde.org website. Clicking the "
"Install button associated with a theme will install this theme locally."
msgstr ""

#: installer.cpp:135
msgid "Install Theme File..."
msgstr "Zainstaluj fajł matyva..."

#: installer.cpp:136
msgid "Install a theme archive file you already have locally"
msgstr "Zainstaluj archiŭny fajł matyva, jaki lažyć na tvaim dysku"

#: installer.cpp:137
msgid ""
"If you already have a theme archive locally, this button will unpack it and "
"make it available for KDE applications"
msgstr ""
"Kali archiŭ z hetym matyvam užo lažyć na tvaim dysku, tady hetaja knopka raspakuje "
"jaho j zrobić jaho dastupnym dla aplikacyjaŭ systemy „KDE”."

#: installer.cpp:141
msgid "Remove Theme"
msgstr "Vydali matyŭ"

#: installer.cpp:142
msgid "Remove the selected theme from your disk"
msgstr "Vydali vyłučany matyŭ z tvajho dysku"

#: installer.cpp:143
msgid "This will remove the selected theme from your disk."
msgstr "Hetaja aperacyja vydalić vyłučany matyŭ z tvajho dysku."

#: installer.cpp:148
msgid "Test Theme"
msgstr "Pasprabuj matyŭ"

#: installer.cpp:149
msgid "Test the selected theme"
msgstr "Pasprabuj vyłučany matyŭ"

#: installer.cpp:150
msgid "This will test the selected theme."
msgstr "Hetaja aperacyja pakaža tabie vyłučany matyŭ."

#: installer.cpp:365
#, kde-format
msgid "Delete folder %1 and its contents?"
msgstr "Vydalić kataloh „%1” z usim jahonym źmieścivam?"

#: installer.cpp:365
msgid "&Delete"
msgstr "&Vydali"

#: installer.cpp:372
#, kde-format
