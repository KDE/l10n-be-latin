msgid "Connection Type"
msgstr "Typ spałučeńnia"

#: HostConnector.cc:78
msgid "ssh"
msgstr "SSH"

#: HostConnector.cc:81
msgid "Select this to use the secure shell to login to the remote host."
msgstr ""
"Vybiery hetuju opcyju, kali chočaš uvajści ŭ daloki host praź biaśpiečnuju "
"abałonku „SSH”."

#: HostConnector.cc:84
msgid "rsh"
msgstr "RSH"

#: HostConnector.cc:85
msgid "Select this to use the remote shell to login to the remote host."
msgstr ""
"Vybiery hetuju opcyju, kali chočaš uvajści ŭ daloki host praź abałonku „RSH”."

#: HostConnector.cc:88
msgid "Daemon"
msgstr "Słužba"

#: HostConnector.cc:89
msgid ""
"Select this if you want to connect to a ksysguard daemon that is running on "
"the machine you want to connect to, and is listening for client requests."
msgstr ""
"Vybiery hetuju opcyju, kali chočaš spałučycca sa słužbaju „ksysguard”, "
"jakaja pracuje na dalokim hoście j čakaje zvarotaŭ ad klijentaŭ."

#: HostConnector.cc:92
msgid "Custom command"
msgstr "Ułasny zahad"

#: HostConnector.cc:93
msgid ""
"Select this to use the command you entered below to start ksysguardd on the "
"remote host."
msgstr ""
"Vybiery hetuju opcyju, kali chočaš uklučać słužbu „ksysguardd” na dalokim "
"hoście hetym zahadam."

#: HostConnector.cc:96
msgid "Port:"
msgstr "Port:"

#: HostConnector.cc:103
msgid ""
"Enter the port number on which the ksysguard daemon is listening for "
"connections."
msgstr ""
"Upišy numar porta, na jakim słužba „ksysguard” budzie čakać spałučeńniaŭ."

#: HostConnector.cc:106
msgid "e.g.  3112"
msgstr "naprykład, „3112”"

#: HostConnector.cc:109
msgid "Command:"
msgstr "Zahad:"

#: HostConnector.cc:118
msgid "Enter the command that runs ksysguardd on the host you want to monitor."
msgstr "Upišy zahad, jaki ŭklučaje słužbu „ksysguardd” na patrebnym hoście."

#: HostConnector.cc:122
msgid "e.g. ssh -l root remote.host.org ksysguardd"
msgstr "naprykład, „ssh -l root remote.host.org ksysguardd”"

