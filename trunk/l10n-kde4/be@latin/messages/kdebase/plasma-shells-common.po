#: appletbrowser.cpp:469
msgid "Install Widget From Local File..."
msgstr "Zainstaluj widžet ź miascovaha fajła..."

#: appletbrowser.cpp:480
msgid "Widgets"
msgstr "Widžety"

#: appletbrowser.cpp:483
msgid "Add Widget"
msgstr "Dadaj widžet"

#: appletbrowser.cpp:484
msgid "Install New Widgets"
msgstr "Zainstaluj novych widžetaŭ"

#: appletbrowser.cpp:486
msgid "Get New Widgets"
msgstr "Vaźmi novych widžetaŭ"

#: appletbrowser.cpp:490
msgid "Close the dialog"
msgstr "Začyni hetaje akno"

#: appletbrowser.cpp:491
msgid ""
"<qt>When clicking <b>Close</b>, this dialog will be closed with no further "
"action taken.</qt>"
msgstr ""
"<qt>Kali ty kliknieš u knopku <b>Začyni</b>, hetaje akno budzie začynienaje, "
"ale ničoha nia budzie zroblena.</qt>"

#: appletbrowser.cpp:492
msgid "Add selected widgets"
msgstr "Dadaj vyłučanyja widžety"

#: appletbrowser.cpp:493
msgid ""
"<qt>When clicking <b>Add Widget</b>, the selected widgets will be added to "
"your desktop.</qt>"
msgstr ""
"<qt>Kali ty kliknieš u knopku <b>Dadaj widžet</b>, vyłučanyja widžety buduć "
"vystaŭlenyja na tvaim rabočym stale.</qt>"

#: appletbrowser.cpp:494
msgid "Install new widgets"
msgstr "Zainstaluj novych widžetaŭ"

#: appletbrowser.cpp:495
msgid ""
"<qt>Selecting <b>Get New Widgets</b> will show a window that allows you to "
"download new widgets directly from the Internet, while Install From File "
"allows you to add new widgets from files you have on disk.</qt>"
msgstr ""
"<qt>Kali ty kliknieš u knopku <b>Vaźmi novych widžetaŭ</b>, budzie "
"pakazanaje akno, ź jakim možna brać ź sieciva novyja widžety. Knopka "
"„Zainstaluj z fajła” dazvalaje dadavać novyja widžety z fajłaŭ, źmieščanych "
"na tvaim dysku.</qt>"

