#: clock.cpp:159
msgid "General"
msgstr "Hałoŭnaje"

#: clock.cpp:259
#, kde-format
msgctxt "@label Short date: %1 day in the month, %2 short month name, %3 year"
msgid "%1 %2 %3"
msgstr "%1 %2 %3"

#: clock.cpp:263
#, kde-format
msgctxt "@label Short date: %1 day in the month, %2 short month name"
msgid "%1 %2"
msgstr "%1 %2"

#: clock.cpp:271
#, kde-format
msgctxt "@label Day of the week with date: %1 short day name, %2 short date"
msgid "%1, %2"
msgstr "%1, %2"

#: clock.cpp:278
#, kde-format
msgctxt ""
"@label Date with currentTimezone: %1 day of the week with date, %2 "
"currentTimezone"
msgid "%1 %2"
msgstr "%1 %2"

#. i18n: file: clockConfig.ui:19
#. i18n: ectx: property (toolTip), widget (QGroupBox, groupBox)
#: rc.cpp:3
msgid "Font properties for the clock"
msgstr "Ułaścivaści šryfta dla hadzińnika"

#. i18n: file: clockConfig.ui:22
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:6
msgid "Font"
msgstr "Šryft"

#. i18n: file: clockConfig.ui:31
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:9
msgid "Font style:"
msgstr "Kštałt šryfta:"

#. i18n: file: clockConfig.ui:46
#. i18n: ectx: property (toolTip), widget (KFontComboBox, plainClockFont)
#: rc.cpp:12
msgid "Choose the font family"
msgstr "Vybiery rod šryftoŭ"

#. i18n: file: clockConfig.ui:49
#. i18n: ectx: property (whatsThis), widget (KFontComboBox, plainClockFont)
#: rc.cpp:15
msgid ""
"You can change the default family font for the clock. Choose the new one in "
"the list."
msgstr "Ty možaš vybrać zmoŭčany rod šryftoŭ dla hadzińnika z hetaha śpisu."

#. i18n: file: clockConfig.ui:501
#. i18n: ectx: property (toolTip), widget (QCheckBox, plainClockFontBold)
#: rc.cpp:104
msgid "Check if you want the font in bold"
msgstr "Uklučy hetuju opcyju, kali chočaš tłusty šryft."

#. i18n: file: clockConfig.ui:504
#. i18n: ectx: property (whatsThis), widget (QCheckBox, plainClockFontBold)
#: rc.cpp:107
msgid "When this is checked, the clock font will be bold."
msgstr "Kali ŭklučanaja hetaja opcyja, šryft hadzińnika budzie tłustym."

#. i18n: file: clockConfig.ui:507
#. i18n: ectx: property (text), widget (QCheckBox, plainClockFontBold)
#: rc.cpp:110
msgid "&Bold"
msgstr "&Tłusty"

#. i18n: file: clockConfig.ui:514
#. i18n: ectx: property (toolTip), widget (QCheckBox, plainClockFontItalic)
#: rc.cpp:113
msgid "Check if you want the font in italic"
msgstr "Uklučy hetuju opcyju, kali chočaš mieć kursiŭny šryft."

#. i18n: file: clockConfig.ui:517
#. i18n: ectx: property (whatsThis), widget (QCheckBox, plainClockFontItalic)
#: rc.cpp:116
msgid "When this is checked, the clock font will be in italic."
msgstr "Kali ŭklučanaja hetaja opcyja, šryft hadzińnika budzie kursiŭnym."

#. i18n: file: clockConfig.ui:520
#. i18n: ectx: property (text), widget (QCheckBox, plainClockFontItalic)
#: rc.cpp:119
msgid "&Italic"
msgstr "&Kursiŭny"

#. i18n: file: clockConfig.ui:543
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:122
msgid "Font color:"
msgstr "Koler šryfta:"

#. i18n: file: clockConfig.ui:562
#. i18n: ectx: property (toolTip), widget (QRadioButton, useThemeColor)
#: rc.cpp:125
msgid "Use current desktop theme color"
msgstr "Karystajsia kolerami dziejnaha matyvu rabočaha stała"

#. i18n: file: clockConfig.ui:565
#. i18n: ectx: property (whatsThis), widget (QRadioButton, useThemeColor)
#: rc.cpp:128
msgid ""
"This is default. The clock will get its font color from the current desktop "
"theme."
msgstr ""
"Heta zmoŭčanaja vartaść nałady. Šryft hadzińnika budzie adpaviadać koleru, "
"aznačanamu dla dziejnaha matyvu rabočaha stała."

#. i18n: file: clockConfig.ui:568
#. i18n: ectx: property (text), widget (QRadioButton, useThemeColor)
#: rc.cpp:131
msgid "Use theme color"
msgstr "Karystajsia kolerami matyvu"

#. i18n: file: clockConfig.ui:586
#. i18n: ectx: property (toolTip), widget (QRadioButton, useCustomColor)
#: rc.cpp:134
msgid "Choose your own font color"
msgstr "Vybiery svoj koler šryfta"

#. i18n: file: clockConfig.ui:589
#. i18n: ectx: property (whatsThis), widget (QRadioButton, useCustomColor)
#: rc.cpp:137
msgid ""
"When checked you can choose a custom color for the clock font by clicking on "
"the font widget on the right."
msgstr ""
"Kali ŭklučanaja hetaja opcyja, ty možaš vybrać ułasny koler dla šryfta "
"hadzińnika, kliknuŭšy ŭ widžet sprava."

#. i18n: file: clockConfig.ui:592
#. i18n: ectx: property (text), widget (QRadioButton, useCustomColor)
#: rc.cpp:140
msgid "Use custom color"
msgstr "Karystajsia ŭlasnymi kolerami"

#. i18n: file: clockConfig.ui:602
#. i18n: ectx: property (toolTip), widget (KColorButton, plainClockColor)
#: rc.cpp:143
msgid "Color chooser"
msgstr "Vybar koleru"

#. i18n: file: clockConfig.ui:605
#. i18n: ectx: property (whatsThis), widget (KColorButton, plainClockColor)
#: rc.cpp:146
msgid ""
"Click on this button and the KDE standard color dialog will show. You can "
"then choose the new color you want for your clock."
msgstr ""
"Klikni ŭ hetuju knopku, kab ubačyć zvykłaje akno vybaru koleru. Tam ty "
"zmožaš vybrać novy koler dla svajho hadzińnika."

#. i18n: file: clockConfig.ui:630
#. i18n: ectx: property (toolTip), widget (QGroupBox, groupBox_2)
#: rc.cpp:149
msgid "Display additional information"
msgstr "Pakazvaj dadatkovyja źviestki"

#. i18n: file: clockConfig.ui:633
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:152
msgid "Information"
msgstr "Źviestki"

#. i18n: file: clockConfig.ui:642
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:155
msgid "Show date:"
msgstr "Pakazvaj datu:"

#. i18n: file: clockConfig.ui:657
#. i18n: ectx: property (toolTip), widget (QCheckBox, showDate)
#: rc.cpp:158
msgid "Display the date of the day"
msgstr "Pakazvaj datu"

#. i18n: file: clockConfig.ui:706
#. i18n: ectx: property (toolTip), widget (QCheckBox, showDay)
#: rc.cpp:161
msgid "Display day of the week"
msgstr "Pakazvaj dzień tydnia"

#. i18n: file: clockConfig.ui:709
#. i18n: ectx: property (whatsThis), widget (QCheckBox, showDay)
#: rc.cpp:164
msgid "Add the day of the week to the date display."
msgstr "Dadaj dzień tydnia da vyjaŭleńnia daty."

#. i18n: file: clockConfig.ui:712
#. i18n: ectx: property (text), widget (QCheckBox, showDay)
#: rc.cpp:167
msgid "Show day of the &week"
msgstr "Pakazvaj dzień &tydnia"

#. i18n: file: clockConfig.ui:738
#. i18n: ectx: property (toolTip), widget (QCheckBox, showYear)
#: rc.cpp:170
msgid "Display the current year"
msgstr "Pakazvaj hod"

#. i18n: file: clockConfig.ui:741
#. i18n: ectx: property (whatsThis), widget (QCheckBox, showYear)
#: rc.cpp:173
msgid "Add the year to the date string."
msgstr "Dadaj hod da vyjaŭleńnia daty."

#. i18n: file: clockConfig.ui:744
#. i18n: ectx: property (text), widget (QCheckBox, showYear)
#: rc.cpp:176
msgid "Show &year"
msgstr "Pakazvaj &hod"

#. i18n: file: clockConfig.ui:769
#. i18n: ectx: property (text), widget (QLabel, label_4)
#: rc.cpp:179
msgid "Show time zone:"
msgstr "Pakazvaj časavy pojas:"

#. i18n: file: clockConfig.ui:784
#. i18n: ectx: property (toolTip), widget (QCheckBox, showTimeZone)
#: rc.cpp:182
msgid "Display the time zone name"
msgstr "Pakazvaj nazvu časavaha pojasu"

#. i18n: file: clockConfig.ui:787
#. i18n: ectx: property (whatsThis), widget (QCheckBox, showTimeZone)
#: rc.cpp:185
msgid "Display the time zone name under the time."
msgstr "Pakazvaj nazvu časavaha pojasu pad časam."

#. i18n: file: clockConfig.ui:812
#. i18n: ectx: property (text), widget (QLabel, label_5)
#: rc.cpp:188
msgid "Show seconds:"
msgstr "Pakazvaj sekundy:"

#. i18n: file: clockConfig.ui:827
#. i18n: ectx: property (toolTip), widget (QCheckBox, secondsCheckbox)
#: rc.cpp:191
msgid "Show the seconds"
msgstr "Pakazvaj sekundy"

#. i18n: file: clockConfig.ui:830
#. i18n: ectx: property (whatsThis), widget (QCheckBox, secondsCheckbox)
#: rc.cpp:194
msgid "Check this if you want to show the seconds."
msgstr "Uklučy hetuju opcyju, kali chočaš bačyć sekundy."

