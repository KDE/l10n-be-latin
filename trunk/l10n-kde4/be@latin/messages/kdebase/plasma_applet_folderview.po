#. i18n: file: folderviewDisplayConfig.ui:24
#. i18n: ectx: property (text), widget (QLabel, lblCustomLabel)
#: rc.cpp:3
msgid "Label:"
msgstr "Tekst:"

#. i18n: file: folderviewDisplayConfig.ui:39
#. i18n: ectx: property (whatsThis), widget (KLineEdit, labelEdit)
#: rc.cpp:6
msgid ""
"This edit field contains the label which is shown at the top of the applet.\n"
"\n"
"By default it contains the name of the place being shown in the applet, but "
"if you prefer to have a custom label you can enter it here."
msgstr ""
"Hetaje pole ŭtrymvaje tekst, jaki pakazvajecca ŭhary apleta.\n"
"\n"
"Zmoŭčana tut źmiaščajecca nazva miesca, jakoje adpaviadaje hetamu apletu, "
"ale kali ty chočaš bačyć ułasny tekst, tady možaš jaho siudy ŭpisać."

#. i18n: file: folderviewDisplayConfig.ui:48
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:11
msgid "Icon Settings"
msgstr "Nałady ikon"

#. i18n: file: folderviewDisplayConfig.ui:57
#. i18n: ectx: property (text), widget (QLabel, label_4)
#: rc.cpp:14
msgid "Icon size:"
msgstr "Pamier ikon:"

#. i18n: file: folderviewDisplayConfig.ui:85
#. i18n: ectx: property (text), widget (QLabel, label_5)
#: rc.cpp:17
msgid "Small"
msgstr "Mały"

#. i18n: file: folderviewDisplayConfig.ui:95
#. i18n: ectx: property (whatsThis), widget (QSlider, sizeSlider)
#: rc.cpp:20
msgid ""
"Use this slider to increase or decrease the size of the icons in the view."
msgstr ""
"Z dapamohaju hetaha rehulatara možna pavialičyć albo źmienšyć pamier ikonaŭ "
"u prahladzie."

#. i18n: file: folderviewDisplayConfig.ui:117
#. i18n: ectx: property (text), widget (QLabel, label_6)
#: rc.cpp:23
msgid "Large"
msgstr "Vialiki"

#. i18n: file: folderviewDisplayConfig.ui:144
#. i18n: ectx: property (whatsThis), widget (QCheckBox, showPreviews)
#: rc.cpp:26
msgid ""
"Check this option if you want to see previews of the file contents in the "
"icons."
msgstr ""
"Uklučy hetuju opcyju, kali chočaš bačyć ikony z padhladami dla źmieściva "
"fajłaŭ."

#. i18n: file: folderviewDisplayConfig.ui:147
#. i18n: ectx: property (text), widget (QCheckBox, showPreviews)
#: rc.cpp:29
msgid "Show previews"
msgstr "Pakazvaj padhlady"

#. i18n: file: folderviewDisplayConfig.ui:154
#. i18n: ectx: property (whatsThis), widget (QPushButton, previewsAdvanced)
#: rc.cpp:32
msgid ""
"Click this button to choose for which types of files previews will be shown."
msgstr ""
"Klikni ŭ hetuju knopku, kab vybrać typy fajłaŭ, dla jakich treba pakazvać "
"padhlady."

#. i18n: file: folderviewDisplayConfig.ui:157
#. i18n: ectx: property (text), widget (QPushButton, previewsAdvanced)
#: rc.cpp:35
msgid "Advanced Options"
msgstr "Asablivyja opcyi"

#. i18n: file: folderviewDisplayConfig.ui:182
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: rc.cpp:38
msgid "Text Settings"
msgstr "Nałady tekstu"

#. i18n: file: folderviewDisplayConfig.ui:191
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:41
msgid "Text color:"
msgstr "Koler tekstu:"

#. i18n: file: folderviewDisplayConfig.ui:206
#. i18n: ectx: property (whatsThis), widget (KColorButton, colorButton)
#: rc.cpp:44
msgid ""
"Click this button to choose the color which is used for the text labels in "
"the view."
msgstr "Klikni ŭ hetuju knopku, kab vybrać koler dla tekstaŭ u prahladzie."

#. i18n: file: folderviewDisplayConfig.ui:231
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:47
msgid "Number of lines:"
msgstr "Kolkaść radkoŭ:"

#. i18n: file: folderviewDisplayConfig.ui:252
#. i18n: ectx: property (whatsThis), widget (QSpinBox, numLinesEdit)
#: rc.cpp:50
msgid ""
"Use this control to choose how many lines of text will be shown below the "
"icons."
msgstr ""
"Z dapamohaju hetaha rehulatara možna vybrać, kolki treba pakazvać radkoŭ "
"tekstu pad ikonami."

#. i18n: file: folderviewDisplayConfig.ui:284
#. i18n: ectx: property (whatsThis), widget (QCheckBox, drawShadows)
#: rc.cpp:53
msgid ""
"<html><body><p>Check this option if you want the text labels to cast a "
"shadow on the background.</p>\n"
"<p></p>\n"
"<p>Shadows help make the text easier to read by making it stand out more "
"from the background.</p>\n"
"<p></p>\n"
"<p><i>Note that with dark text colors, this option will cause the text to "
"glow with a bright halo, instead of casting a shadow.</i></p></body></html>"
msgstr ""
"<html><body><p>Uklučy hetuju opcyju, kali chočaš, kab podpisy kidali cień na "
"fon.</p>\n"
"<p></p>\n"
"<p>Cień robić tekst zručniejšym dla čytańnia, bo toj tady bolš vyłučajecca z "
"fonu.</p>\n"
"<p></p>\n"
"<p><i>Zvažaj: dla ciomnaha tekstu zamiest cieniu fon vyśviatlajecca.</i></"
"p></body></html>"

#. i18n: file: folderviewDisplayConfig.ui:287
#. i18n: ectx: property (text), widget (QCheckBox, drawShadows)
#: rc.cpp:60
msgid "Show text shadows"
msgstr "Pakazvaj cień dla tekstu"

#. i18n: file: folderviewDisplayConfig.ui:297
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:63
msgid "Icon Arrangement"
msgstr "Vykład ikon"

#. i18n: file: folderviewDisplayConfig.ui:310
#. i18n: ectx: property (text), widget (QLabel, flowLabel)
#: rc.cpp:66
msgid "Arrange icons:"
msgstr "Vykładvaj ikony:"

#. i18n: file: folderviewDisplayConfig.ui:323
#. i18n: ectx: property (whatsThis), widget (QComboBox, flowCombo)
#: rc.cpp:69
msgid ""
"Use this control to choose if you want the icons to be arranged top to "
"bottom starting on the left side of the view, or arranged left to right "
"starting at the top of the view."
msgstr ""
"Z dapamohaju hetaha rehulatara možna vybrać sposab, u jaki treba vykładvać "
"ikony: źvierchu ŭniz, pačaŭšy ad levaha kraju prahladu, albo źleva ŭprava, "
"pačaŭšy ad vierchniaha kraju."

#. i18n: file: folderviewDisplayConfig.ui:330
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:72
msgid "Sort icons:"
msgstr "Paradkuj ikony:"

#. i18n: file: folderviewDisplayConfig.ui:343
#. i18n: ectx: property (whatsThis), widget (QComboBox, sortCombo)
#: rc.cpp:75
msgid ""
"Use this control to choose the criteria by which the icons will be sorted in "
"the view."
msgstr ""
"Z dapamohaju hetaha rehulatara možna vybrać prymietu, pavodle jakoj treba "
"paradkavać ikony prahladu."

#. i18n: file: folderviewDisplayConfig.ui:369
#. i18n: ectx: property (whatsThis), widget (QCheckBox, alignToGrid)
#: rc.cpp:78
msgid ""
"Check this option if you want the icons to be arranged in a grid.\n"
"\n"
"When this option is checked, icons will automatically snap to the nearest "
"grid cell when you move them around in the view."
msgstr ""
"Uklučy hetuju opcyju, kali chočaš vykładvać ikony ŭ sietcy.\n"
"\n"
"Kali ŭklučanaja hetaja opcyja, ikony dapasoŭvajucca da najbližejšaj kamory "
"sietki."

#. i18n: file: folderviewDisplayConfig.ui:372
#. i18n: ectx: property (text), widget (QCheckBox, alignToGrid)
#: rc.cpp:83
msgid "Align icons in a grid"
msgstr "Dapasoŭvaj ikony da sietki"

#. i18n: file: folderviewDisplayConfig.ui:381
#. i18n: ectx: property (whatsThis), widget (QCheckBox, lockInPlace)
#: rc.cpp:86
msgid ""
"Check this option if you do not want the icons to be moveable in the view.\n"
"\n"
"This option is useful if you want to avoid accidentally moving the icons "
"while interacting with them."
msgstr ""
"Uklučy hetuju opcyju, kali chočaš, kab ikony ŭ prahladzie možna było "
"pierasoŭvać.\n"
"\n"
"Hetaja opcyja karysnaja, kali ty nia chočaš, kab ikony možna było vypadkova "
"pierasunuć."

#. i18n: file: folderviewDisplayConfig.ui:384
#. i18n: ectx: property (text), widget (QCheckBox, lockInPlace)
#: rc.cpp:91
msgid "Lock icons in place"
msgstr "Zamacuj ikony na miascoch"

#. i18n: file: folderviewFilterConfig.ui:29
#. i18n: ectx: property (text), item, widget (QComboBox, filterType)
#: rc.cpp:94
msgid "Show All Files"
msgstr "Pakazvaj usie fajły"

#. i18n: file: folderviewFilterConfig.ui:34
#. i18n: ectx: property (text), item, widget (QComboBox, filterType)
#: rc.cpp:97
msgid "Show Files Matching"
msgstr "Pakazvaj adpaviednyja fajły"

#. i18n: file: folderviewFilterConfig.ui:39
#. i18n: ectx: property (text), item, widget (QComboBox, filterType)
#: rc.cpp:100
msgid "Hide Files Matching"
msgstr "Chavaj adpaviednyja fajły"

#. i18n: file: folderviewFilterConfig.ui:126
#. i18n: ectx: property (text), widget (QPushButton, selectAll)
#: rc.cpp:103
msgid "Select All"
msgstr "Vyłučy ŭsio"

#. i18n: file: folderviewFilterConfig.ui:133
#. i18n: ectx: property (text), widget (QPushButton, deselectAll)
#: rc.cpp:106
msgid "Deselect All"
msgstr "Anuluj vyłučeńnie ŭsiaho"

#. i18n: file: folderviewFilterConfig.ui:157
#. i18n: ectx: property (clickMessage), widget (KLineEdit, searchMimetype)
#: rc.cpp:109
msgid "Search file type"
msgstr "Šukaj typ fajła"

#. i18n: file: folderviewFilterConfig.ui:167
#. i18n: ectx: property (text), widget (QLabel, fileTypesLabel)
#: rc.cpp:112
msgid "File types:"
msgstr "Typy fajłaŭ:"

#. i18n: file: folderviewFilterConfig.ui:174
#. i18n: ectx: property (text), widget (QLabel, fileNameLabel)
#: rc.cpp:115
msgid "File name pattern:"
msgstr "Šablon nazvaŭ fajłaŭ:"

#. i18n: file: folderviewFilterConfig.ui:187
#. i18n: ectx: property (toolTip), widget (KLineEdit, filterFilesPattern)
#: rc.cpp:118
msgid "Space-separated list of extensions, e.g. *.txt *.od*"
msgstr ""
"Śpis pašyreńniaŭ fajłaŭ, naprykład, „*.txt *.od*”, padzieleny prabiełami"

#. i18n: file: folderviewFilterConfig.ui:190
#. i18n: ectx: property (whatsThis), widget (KLineEdit, filterFilesPattern)
#: rc.cpp:121
msgid ""
"Space-separated list of extensions, e.g. *.txt *.od* to display only office- "
"and text-files"
msgstr ""
"Śpis pašyreńniaŭ fajłaŭ, naprykład, „*.txt *.od*”, padzieleny prabiełami, "
"jaki adpaviadaje tekstavym dy ofisnym fajłam"

#. i18n: file: folderviewFilterConfig.ui:199
#. i18n: ectx: property (clickMessage), widget (KLineEdit, filterFilesPattern)
#: rc.cpp:124
msgid "Pattern filter"
msgstr "Šablonny filter"

#. i18n: file: folderviewLocationConfig.ui:16
#. i18n: ectx: property (text), widget (QRadioButton, showDesktopFolder)
#: rc.cpp:127
msgid "Show the Desktop folder"
msgstr "Pakazvaj kataloh stała"

#. i18n: file: folderviewLocationConfig.ui:23
#. i18n: ectx: property (text), widget (QRadioButton, showPlace)
#: rc.cpp:130
msgid "Show a Place:"
msgstr "Pakazvaj miesca:"

#. i18n: file: folderviewLocationConfig.ui:53
#. i18n: ectx: property (text), widget (QRadioButton, showCustomFolder)
#: rc.cpp:133
msgid "Specify a folder:"
msgstr "Aznač kataloh:"

#. i18n: file: folderviewLocationConfig.ui:84
#. i18n: ectx: property (clickMessage), widget (KUrlRequester, lineEdit)
#: rc.cpp:136
msgid "Type a path or a URL here"
msgstr "Tut upišy ściežku ci adras."

#. i18n: file: folderviewPreviewConfig.ui:16
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:139
msgid "Check the file types you want icon previews for:"
msgstr "Aznač typy fajłaŭ, dla jakich treba pakazvać padhlady:"

#~ msgid ""
#~ "<html><body><b>Note: The Desktop folder currently does not exist.<br />If "
#~ "you select this option and click OK it will be created for you.</b></"
#~ "body></html>"
#~ msgstr ""
#~ "<html><body><b>Uvaha: Kataloh rabočaha stała pakul nie isnuje.<br />Kali "
#~ "ty vybieraš hetuju opcyju i kliknieš u knopku „Ok”, tady systema jaho "
