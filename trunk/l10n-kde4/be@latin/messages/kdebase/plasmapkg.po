#: main.cpp:38
msgid "Install, list, remove Plasma packages"
msgstr "Instaluj, prahladaj i vydalaj pakunki „Plasma”"

#: main.cpp:75
msgid "Plasma Package Manager"
msgstr "Kiraŭnik pakunkaŭ „Plasma”"

#: main.cpp:77
msgid "(C) 2008, Aaron Seigo"
msgstr "© 2008, Aaron Seigo"

#: main.cpp:78
msgid "Aaron Seigo"
msgstr "Aaron Seigo"

#: main.cpp:79
msgid "Original author"
msgstr "Pieršy aŭtar"

#: main.cpp:88
msgid "For install or remove, operates on packages installed for all users."
msgstr "Instaluje j vydalaje pakunki, dastupnyja dla ŭsich karystańnikaŭ."

#: main.cpp:94
#, fuzzy
msgctxt ""
"theme, wallpaper, etc. are keywords, but they may be translated, as both "
"versions are recognized by the application (if translated, should be same as "
"messages with 'package type' context below)"
msgid ""
"The type of package, e.g. theme, wallpaper, plasmoid, dataengine, runner, "
"layout-template, etc."
msgstr ""
"Typ pakunka, naprykład, matyŭ, špalery, widžet „Plasma”, žarało źviestak, "
"„Runner” itp."

#: main.cpp:98
msgctxt "Do not translate <path>"
msgid "Install the package at <path>"
msgstr "Zainstaluj pakunak u <path>"

#: main.cpp:100
msgctxt "Do not translate <path>"
msgid "Upgrade the package at <path>"
msgstr "Zainstaluj pakunak u <path>"

#: main.cpp:102
msgid "List installed packages"
msgstr "Pakažy zainstalavanyja pakunki"

#: main.cpp:104
msgctxt "Do not translate <name>"
msgid "Remove the package named <name>"
msgstr "Vydali pakunak z nazvaju <name>"

#: main.cpp:106
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this KDE session will be searched instead."
msgstr ""
"Absalutnaja hałoŭnaja ściežka pakunka. Kali jana nie aznačanaja, tady pošuk "
"budzie dziejničać sa zvyčajnymi katalohami źviestak, padadzienymi dla hetaj "
"sesii systemy „KDE”."

