#: main.cpp:36
msgid "Install, list, remove Plasma packages"
msgstr "Instaluj, prahladaj i vydalaj pakunki „Plasma”"

#: main.cpp:47
msgid "Listing is not yet implemented."
msgstr "Prahlad jašče nie absłuhoŭvajecca."

#: main.cpp:52
msgid "Plasma Package Manager"
msgstr "Kiraŭnik pakunkaŭ „Plasma”"

#: main.cpp:54
msgid "(C) 2008, Aaron Seigo"
msgstr "© 2008, Aaron Seigo"

#: main.cpp:55
msgid "Aaron Seigo"
msgstr "Aaron Seigo"

#: main.cpp:56
msgid "Original author"
msgstr "Pieršy aŭtar"

#: main.cpp:65
msgid "For install or remove, operates on packages installed for all users."
msgstr "Instaluje j vydalaje pakunki, dastupnyja dla ŭsich karystańnikaŭ."

#: main.cpp:68
msgid ""
"The type of package, e.g. theme, wallpaper, plasmoid, DataEngine, Runner, "
"etc."
msgstr ""
"Typ pakunka, naprykład, matyŭ, špalery, widžet „Plasma”, žarało źviestak, "
"„Runner” itp."

#: main.cpp:72
#, fuzzy
msgid "Install the package at <path>"
msgstr "Zainstaluj pakunak u <ściežku>"

#: main.cpp:74
msgid "List installed packages"
msgstr "Pakažy zainstalavanyja pakunki"

#: main.cpp:76
#, fuzzy
msgid "Remove the package named <name>"
msgstr "Vydali pakunak z nazvaju <nazva>"

#: main.cpp:78
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this KDE session will be searched instead."
msgstr ""
"Absalutnaja hałoŭnaja ściežka pakunka. Kali jana nie aznačanaja, tady pošuk "
"budzie dziejničać sa zvyčajnymi katalohami źviestak, padadzienymi dla hetaj "
"sesii systemy „KDE”."

#: main.cpp:97
msgid "plasmoid"
msgstr "widžet „Plasma”"

#: main.cpp:100
msgid "theme"
msgstr "matyŭ"

#: main.cpp:102
msgid "wallpaper"
msgstr "špalery"

#: main.cpp:104
msgid "dataengine"
msgstr "žarało źviestak"

#: main.cpp:107
msgid "runner"
msgstr "runner"

#: main.cpp:118
#, kde-format
msgid "Could not find a suitable installer for package of type %1"
msgstr "Nie ŭdałosia znajści prydatny instalatar dla pakunka typu „%1”."

#: main.cpp:127
#, kde-format
msgid "Could not load installer for package of type %1. Error reported was: %2"
msgstr ""
"Nie ŭdałosia znajści prydatny instalatar dla pakunka typu „%1”. Uźnikła "
"pamyłka: %2."

#: main.cpp:149
#, kde-format
msgid "Successfully installed %1"
msgstr "Pakunak „%1” paśpiachova zainstalavany."

#: main.cpp:151
#, kde-format
msgid "Installation of %1 failed."
msgstr "Nie ŭdałosia zainstalavać pakunak „%1”."

#: main.cpp:157
#, kde-format
msgid "Successfully removed %1"
msgstr "Pakunak „%1” paśpiachova vydaleny."

#: main.cpp:159
#, kde-format
msgid "Removal of %1 failed."
msgstr "Nie ŭdałosia vydalić pakunak „%1”."

#: main.cpp:163
#, fuzzy
msgid "One of install, remove or list is required."
msgstr "Treba vybrać instalavańnie, vydaleńnie albo prahlad."

