#: interfaces/kimproxy/interface/dbusinstantmessenger.desktop:4
msgctxt "Comment"
msgid "Instant Messenger with a D-Bus interface"
msgstr "Kamunikatar z interfejsam „D-Bus”"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:2
msgctxt "Name|standard desktop component"
msgid "Instant Messenger"
msgstr "Kamunikatar"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:48
msgctxt "Comment"
msgid ""
"The instant messenger allows two-way chat between individuals and groups."
msgstr "Kamunikatar dazvalaje vieści razmovu – pryvatnuju albo hurtom."

#: interfaces/kspeech/dbustexttospeech.desktop:4
msgctxt "Comment"
msgid "Text-to-Speech Service with a D-Bus interface"
msgstr "Słužba ahałašeńnia tekstu z interfejsam „D-Bus”"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:2
msgctxt "Name|standard desktop component"
msgid "Embedded Text Editor"
msgstr "Unutrany tekstavy redaktar"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:48
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Słužba redahavańnia tekstaŭ zabiaśpiečvaje aplikacyi prahladnikam i "
"redaktaram tekstaŭ. Aplikacyi KDE, jakija pracujuć z tekstami, pavinnyja "
"karystacca hetaj słužbaj."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr ""
"Unutrany kampanent tekstavaha redaktara (z padziełam na dakumenty j prahlady)"

#: interfaces/ktexteditor/ktexteditor_loadsavefiltercheckplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor load/save filter/check plugin"
msgstr "Plugin adčynieńnia/zapisu filtra/pravierki dla słužby „KTextEditor”"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "Plugin dla KTextEditor"

#: kate/data/katepart.desktop:2
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Unutrany admysłovy tekstavy redaktar"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:16
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Aŭtamatyčnyja zakładki"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:96
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr ""
"Źmiaščaje ŭ radkoch, jakija adpaviadajuć šablonu, zakładki, paśla adčytańnia "
"dakumenta."

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:17
msgctxt "Name"
msgid "Insert File"
msgstr "Ustaŭleńnie fajła"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:101
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Ustaŭlaje źmieściva fajła, jaki možna pračytać, u miescy kursora."

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:17
msgctxt "Name"
msgid "Data Tools"
msgstr "Infarmacyjnaje pryładździe"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:91
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Uklučaje infarmacyjnaje pryładździe, naprykład, tezaŭrus i spraŭdžvańnie "
"pravapisu (kali jany zainstalavanyja)"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:5
msgctxt "Name"
msgid "Python encoding checker/adder"
msgstr "Spraŭdžvańnie j dadańnie aznačeńnia kadavańnia dla Pythona"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:67
msgctxt "Comment"
msgid "While saving check encoding of python files and add an encoding line"
msgstr ""
"Spraŭdžvaje dla zapisvanych fajłaŭ Pythona kadavańnie j dadaje radok ź "
"jahonym aznačeńniem"

#: kate/plugins/timedate/ktexteditor_timedate_config.desktop:7
msgctxt "Name"
msgid "Format of Time & Date insertion"
msgstr "Farmat ustaŭlanaha času j daty"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:18
msgctxt "Name"
msgid "Time & Date"
msgstr "Čas i data"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:99
msgctxt "Comment"
msgid "Insert current Time & Date"
msgstr "Ustaŭlaje ciapierašni čas i datu"

