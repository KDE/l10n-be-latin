msgstr "Nie ŭdałosia prasłuchać „%1”."

#: kio/global.cpp:265
#, kde-format
msgid "Could not accept %1."
msgstr "Nie ŭdałosia pryniać „%1”."

#: kio/global.cpp:271
#, kde-format
msgid "Could not access %1."
msgstr "Nie ŭdałosia dastupicca da „%1”."

#: kio/global.cpp:274
