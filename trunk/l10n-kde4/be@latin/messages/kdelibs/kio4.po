msgstr "Nie ŭdałosia źmianić ułaśnika „%1”."

#: kio/global.cpp:295
#, kde-format
msgid "Could not delete file %1."
msgstr "Nie ŭdałosia vydalić fajł „%1”."

#: kio/global.cpp:298
#, kde-format
