#: kio/renamedialog.cpp:133
msgid "Suggest New &Name"
msgstr "Prapanuj inšuju &nazvu"

#: kio/renamedialog.cpp:139
msgid "&Skip"
msgstr "&Abmini"

#: kio/renamedialog.cpp:140
msgid "Do not copy or move this folder, skip to the next item instead"
msgstr ""
"Nie kapijuj i nie pieranoś hetaha kataloha, ale praciahvaj z nastupnaha "
"elementa"

#: kio/renamedialog.cpp:141
msgid "Do not copy or move this file, skip to the next item instead"
msgstr ""
"Nie kapijuj i nie pieranoś hetaha fajła, ale praciahvaj z nastupnaha elementa"

#: kio/renamedialog.cpp:146
msgctxt "Write files into an existing folder"
msgid "&Write Into"
msgstr "&Zapišy ŭ katalohu"

#: kio/renamedialog.cpp:146
msgid "&Overwrite"
