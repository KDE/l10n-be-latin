"Could not rename partial file %1.\n"
"Please check permissions."
msgstr ""
"Nie ŭdałosia źmianić nazvu niapoŭnaha fajła „%1”.\n"
"Pravier dazvoły."

#: kio/global.cpp:331
#, kde-format
msgid ""
"Could not create symlink %1.\n"
"Please check permissions."
msgstr ""
"Nie ŭdałosia stvaryć symbalny łuč „%1”.\n"
"Pravier dazvoły."

#: kio/global.cpp:337
#, kde-format
