msgstr "Nie ŭdałosia zapisać u fajł „%1”."

#: kio/global.cpp:259
#, kde-format
msgid "Could not bind %1."
msgstr "Nie ŭdałosia paviazać „%1”."

#: kio/global.cpp:262
#, kde-format
